#!/bin/sh
# FTP like the other XC logins (telnet/ssh): start vsftpd at boot and let root
# in without a password until the user sets one. Idempotent; changes nothing
# that is already in place.
changed=0
if [ -x /etc/init.d/vsftpd ]; then
    if ! ls /etc/rc3.d/S*vsftpd >/dev/null 2>&1; then
        ln -sf ../init.d/vsftpd /etc/rc3.d/S80vsftpd; changed=1
    fi
    for l in 0 6; do
        if ! ls /etc/rc$l.d/K*vsftpd >/dev/null 2>&1; then
            ln -sf ../init.d/vsftpd /etc/rc$l.d/K80vsftpd; changed=1
        fi
    done
fi
P=/etc/pam.d/vsftpd
if [ -f $P ] && grep -q '^auth[[:space:]]*required[[:space:]]*/lib/security/pam_unix.so shadow$' $P; then
    sed -i 's|^\(auth[[:space:]]*required[[:space:]]*/lib/security/pam_unix.so shadow\)$|\1 nullok|' $P; changed=1
fi
if [ -z "$D" ] && [ -x /etc/init.d/vsftpd ] && ! pidof vsftpd >/dev/null; then
    /etc/init.d/vsftpd start >/dev/null 2>&1 || true
fi
echo "xc-ftp-access: $([ $changed = 1 ] && echo configured || echo already configured)"
exit 0
