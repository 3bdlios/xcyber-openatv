+static int xc_drm_fd = -2;
+static time_t xc_vblank_off_until = 0;
+
+static void xcWaitVBlank()
+{
+	if (xc_drm_fd == -2)
+	{
+		xc_drm_fd = open("/dev/dri/card0", O_RDWR | O_CLOEXEC);
+		// The first opener of card0 becomes DRM master, and only the master may modeset:
+		// give it up at once (a vblank wait needs none), or xc-display-fix and the live
+		// resolution change get EACCES.
+		if (xc_drm_fd >= 0)
+			ioctl(xc_drm_fd, _IO('d', 0x1f));	/* DRM_IOCTL_DROP_MASTER */
+	}
+	if (xc_drm_fd < 0)
+		return;
+	struct timespec t0, t1;
+	clock_gettime(CLOCK_MONOTONIC, &t0);
+	if (t0.tv_sec < xc_vblank_off_until)
+		return;
+	union {
+		struct { uint32_t type, sequence; unsigned long signal; } request;
+		struct { uint32_t type, sequence; long tval_sec, tval_usec; } reply;
+	} vbl;
+	memset(&vbl, 0, sizeof(vbl));
+	vbl.request.type = 0x1;	/* DRM_VBLANK_RELATIVE */
+	vbl.request.sequence = 1;
+	int ret = ioctl(xc_drm_fd, _IOWR('d', 0x3a, vbl), &vbl);	/* DRM_IOCTL_WAIT_VBLANK */
+	clock_gettime(CLOCK_MONOTONIC, &t1);
+	long ms = (t1.tv_sec - t0.tv_sec) * 1000 + (t1.tv_nsec - t0.tv_nsec) / 1000000;
+	// display off / mode change: no vblanks to wait for, so do not stall the
+	// render thread; present unsynchronised for a while and try again later
+	if (ret < 0 || ms > 100)
+		xc_vblank_off_until = t1.tv_sec + 10;
+}
+
+void gFBDC::xcPresent()
+{
+    if (xc_shadow.empty()) return;
+    if (islocked()) { xc_force_present = true; return; }
+    const size_t row = surface.stride;
+    std::vector<int> changed;
+    for (int y=0; y<surface.y; ++y) {
+        const size_t off = static_cast<size_t>(y) * row;
+        if (xc_force_present || memcmp(xc_shadow.data()+off, xc_presented.data()+off, row))
+            changed.push_back(y);
+    }
+    if (changed.empty()) return;
+    xcWaitVBlank();
+    for (int y : changed) {
+        const size_t off = static_cast<size_t>(y) * row;
+        memcpy(fb->lfb+off, xc_shadow.data()+off, row);
+        memcpy(xc_presented.data()+off, xc_shadow.data()+off, row);
+    }
+    xc_force_present = false;
+}
+
 void gFBDC::exec(const gOpcode *o)
 {
 	std::lock_guard<std::recursive_mutex> lock(m_graphics_mutex);
